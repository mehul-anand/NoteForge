# Copy to .env and fill in. Never commit .env.

# OpenAI (required)
OPENAI_API_KEY=sk-...

# Tavily web search fallback (recommended; agent needs it for external facts)
TAVILY_API_KEY=tvly-...

# Optional: override the versioned default agent system prompt (prompts/agent_v1.md)
# AGENT_SYSTEM_PROMPT=

# Optional: LangSmith tracing (observability)
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=lsv2-...
# LANGCHAIN_PROJECT=noteforge